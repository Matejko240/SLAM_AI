<?xml version="1.0"?>
<sdf version="1.10">
  <model name="diffbot">
    <pose>0 0 0.10 0 0 0</pose>
    <static>false</static>

    <link name="base_link">
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.08</iyy><iyz>0</iyz>
          <izz>0.10</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <box><size>0.30 0.20 0.10</size></box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <box><size>0.30 0.20 0.10</size></box>
        </geometry>
        <material>
          <ambient>0.90 0.12 0.12 1</ambient>
          <diffuse>0.90 0.12 0.12 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>

      <visual name="top_marker_visual">
        <pose>0 0 0.26 0 0 0</pose>
        <geometry>
          <box><size>0.55 0.38 0.02</size></box>
        </geometry>
        <material>
          <ambient>0.10 0.95 0.20 0.95</ambient>
          <diffuse>0.10 0.95 0.20 0.95</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="heading_marker_visual">
        <pose>0.18 0 0.285 0 0 0</pose>
        <geometry>
          <box><size>0.16 0.08 0.03</size></box>
        </geometry>
        <material>
          <ambient>0.98 0.96 0.10 1</ambient>
          <diffuse>0.98 0.96 0.10 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>

      <visual name="mast_visual">
        <pose>0 0 0.50 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.025</radius><length>0.45</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>

      <visual name="mast_cap_visual">
        <pose>0 0 0.74 0 0 0</pose>
        <geometry>
          <sphere><radius>0.055</radius></sphere>
        </geometry>
        <material>
          <ambient>0.10 0.55 1.00 1</ambient>
          <diffuse>0.10 0.55 1.00 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
    </link>

    <link name="left_wheel_link">
      <pose>-0.12 0.105 0 1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.03</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>5.0</mu>
              <mu2>5.0</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="left_wheel_visual">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.03</length></cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel_link">
      <pose>-0.12 -0.105 0 1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.03</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>5.0</mu>
              <mu2>5.0</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="right_wheel_visual">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.03</length></cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <link name="laser_link">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <visual name="laser_visual">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.05</length></cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <collision name="laser_collision">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.05</length></cylinder>
        </geometry>
      </collision>

      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <topic>/lidar</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.08</min>
            <max>10.0</max>
          </range>
        </lidar>
      </sensor>
    </link>

    <link name="caster_link">
      <pose>0.115 0 0 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000002</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000002</iyy><iyz>0</iyz>
          <izz>0.000002</izz>
        </inertia>
      </inertial>
    <collision name="caster_collision">
      <pose>0 0 -0.022 0 0 0</pose>
      <geometry>
        <sphere><radius>0.012</radius></sphere>
      </geometry>

      <surface>
        <friction>
          <ode>
            <mu>0.0001</mu>
            <mu2>0.0001</mu2>
            <slip1>10.0</slip1>
            <slip2>10.0</slip2>
          </ode>
        </friction>
        <contact>
          <ode>
            <min_depth>0.0001</min_depth>
            <kp>100000.0</kp>
            <kd>1.0</kd>
          </ode>
        </contact>
      </surface>
    </collision>
      <visual name="caster_visual">
        <geometry>
          <sphere><radius>0.035</radius></sphere>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="laser_joint" type="fixed">
      <parent>base_link</parent>
      <child>laser_link</child>
    </joint>
    
    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_link</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.25</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom_raw</odom_topic>
      <tf_topic>/tf_raw</tf_topic>
      <frame_id>odom_raw</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>8.0</max_linear_acceleration>
      <max_angular_acceleration>12.0</max_angular_acceleration>
      <max_linear_velocity>5.0</max_linear_velocity>
      <max_angular_velocity>7.5</max_angular_velocity>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </model>
</sdf>
